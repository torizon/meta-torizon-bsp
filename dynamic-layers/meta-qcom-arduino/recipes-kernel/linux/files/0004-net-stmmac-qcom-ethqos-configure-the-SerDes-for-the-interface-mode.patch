From: Stefano Viola <stefano.viola@toradex.com>
Subject: [PATCH] net: stmmac: qcom-ethqos: configure the SerDes for the interface mode

The SerDes speed and the in-band mode are set at link up from the link
speed, while phylink switches the interface between SGMII and 2500BASE-X
with the PHY (QCA8081). After some boots of the Arduino VENTUNO Q the link
comes up at 1G with no RX until the link is bounced.

Set the SerDes speed from the interface mode in .mac_finish(), before the
link comes up, and the in-band mode from the interface, as mainline does
since v7.1 (backport of the logic of 834c72ca306c "move loopback disable
to .mac_finish()", b8ab32315e22 "use phy interface mode for inband" and
fb42f19e671f "move SerDes speed configuration", without the refactoring
they build on). 2.5G and 1G share the MAC configuration; only the
SerDes rate differs.

Two adaptations to 6.18: the SerDes speed is set with phy_set_speed(),
as the 6.18 SerDes PHY driver has no .set_mode (mainline calls
phy_set_mode_ext() with the interface), and the interface is recorded
in .mac_finish() for the link up path instead of being passed to
fix_mac_speed() by the stmmac core. ethqos_set_serdes_speed() returns
the PHY error, which .mac_finish() propagates.

Upstream-Status: Backport [v7.1, adapted to 6.18]
Signed-off-by: Stefano Viola <stefano.viola@toradex.com>
---
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
@@ -124,6 +124,7 @@ struct qcom_ethqos {
 	struct phy *serdes_phy;
 	int serdes_speed;
 	phy_interface_t phy_mode;
+	phy_interface_t serdes_interface;
 
 	const struct ethqos_emac_por *por;
 	unsigned int num_por;
@@ -686,12 +687,19 @@ static int ethqos_configure_rgmii(struct qcom_ethqos *ethqos, int speed)
 	return 0;
 }
 
-static void ethqos_set_serdes_speed(struct qcom_ethqos *ethqos, int speed)
+static int ethqos_set_serdes_speed(struct qcom_ethqos *ethqos, int speed)
 {
-	if (ethqos->serdes_speed != speed) {
-		phy_set_speed(ethqos->serdes_phy, speed);
-		ethqos->serdes_speed = speed;
-	}
+	int ret;
+
+	if (ethqos->serdes_speed == speed)
+		return 0;
+
+	ret = phy_set_speed(ethqos->serdes_phy, speed);
+	if (ret)
+		return ret;
+
+	ethqos->serdes_speed = speed;
+	return 0;
 }
 
 static void ethqos_pcs_set_inband(struct stmmac_priv *priv, bool enable)
@@ -711,24 +719,19 @@ static int ethqos_configure_sgmii(struct qcom_ethqos *ethqos, int speed)
 	val = readl(ethqos->mac_base + MAC_CTRL_REG);
 
 	switch (speed) {
+	/*
+	 * 2.5G and 1G use the same MAC configuration: the line rate differs
+	 * only in the SerDes, set from the interface mode in
+	 * ethqos_mac_finish_serdes().
+	 */
 	case SPEED_2500:
-		val &= ~ETHQOS_MAC_CTRL_PORT_SEL;
-		rgmii_setmask(ethqos, RGMII_CONFIG2_RGMII_CLK_SEL_CFG,
-			      RGMII_IO_MACRO_CONFIG2);
-		ethqos_set_serdes_speed(ethqos, SPEED_2500);
-		ethqos_pcs_set_inband(priv, false);
-		break;
 	case SPEED_1000:
 		val &= ~ETHQOS_MAC_CTRL_PORT_SEL;
 		rgmii_setmask(ethqos, RGMII_CONFIG2_RGMII_CLK_SEL_CFG,
 			      RGMII_IO_MACRO_CONFIG2);
-		ethqos_set_serdes_speed(ethqos, SPEED_1000);
-		ethqos_pcs_set_inband(priv, true);
 		break;
 	case SPEED_100:
 		val |= ETHQOS_MAC_CTRL_PORT_SEL | ETHQOS_MAC_CTRL_SPEED_MODE;
-		ethqos_set_serdes_speed(ethqos, SPEED_1000);
-		ethqos_pcs_set_inband(priv, true);
 		break;
 	case SPEED_10:
 		val |= ETHQOS_MAC_CTRL_PORT_SEL;
@@ -737,11 +740,12 @@ static int ethqos_configure_sgmii(struct qcom_ethqos *ethqos, int speed)
 			      FIELD_PREP(RGMII_CONFIG_SGMII_CLK_DVDR,
 					 SGMII_10M_RX_CLK_DVDR),
 			      RGMII_IO_MACRO_CONFIG);
-		ethqos_set_serdes_speed(ethqos, SPEED_1000);
-		ethqos_pcs_set_inband(priv, true);
 		break;
 	}
 
+	ethqos_pcs_set_inband(priv,
+			      ethqos->serdes_interface == PHY_INTERFACE_MODE_SGMII);
+
 	writel(val, ethqos->mac_base + MAC_CTRL_REG);
 
 	return val;
@@ -756,7 +760,6 @@ static void ethqos_fix_mac_speed(void *priv, int speed, unsigned int mode)
 {
 	struct qcom_ethqos *ethqos = priv;
 
-	qcom_ethqos_set_sgmii_loopback(ethqos, false);
 	ethqos_update_link_clk(ethqos, speed);
 	ethqos_configure(ethqos, speed);
 }
@@ -777,6 +780,23 @@ static int qcom_ethqos_serdes_powerup(struct net_device *ndev, void *priv)
 	return phy_set_speed(ethqos->serdes_phy, ethqos->serdes_speed);
 }
 
+static int ethqos_mac_finish_serdes(struct net_device *ndev, void *priv,
+				    unsigned int mode,
+				    phy_interface_t interface)
+{
+	struct qcom_ethqos *ethqos = priv;
+
+	qcom_ethqos_set_sgmii_loopback(ethqos, false);
+
+	ethqos->serdes_interface = interface;
+	if (interface == PHY_INTERFACE_MODE_SGMII)
+		return ethqos_set_serdes_speed(ethqos, SPEED_1000);
+	if (interface == PHY_INTERFACE_MODE_2500BASEX)
+		return ethqos_set_serdes_speed(ethqos, SPEED_2500);
+
+	return 0;
+}
+
 static void qcom_ethqos_serdes_powerdown(struct net_device *ndev, void *priv)
 {
 	struct qcom_ethqos *ethqos = priv;
@@ -898,6 +918,7 @@ static int qcom_ethqos_probe(struct platform_device *pdev)
 	case PHY_INTERFACE_MODE_2500BASEX:
 	case PHY_INTERFACE_MODE_SGMII:
 		ethqos->configure_func = ethqos_configure_sgmii;
+		plat_dat->mac_finish = ethqos_mac_finish_serdes;
 		break;
 	default:
 		dev_err(dev, "Unsupported phy mode %s\n",
