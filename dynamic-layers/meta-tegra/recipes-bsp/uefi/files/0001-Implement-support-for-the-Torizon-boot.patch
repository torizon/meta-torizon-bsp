+              option text = STRING_TOKEN(STR_TORIZON_NONE), value = 0, flags = 0;
+              option text = STRING_TOKEN(STR_TORIZON_UA), value = 1, flags = 0;
+              option text = STRING_TOKEN(STR_TORIZON_RB), value = 2, flags = 0;
+          endoneof;
+      endif;
+
       oneof varid = DgpuDtEfifbSupport.Enabled,
         questionid = KEY_DGPU_DT_EFIFB_SUPPORT,
         prompt = STRING_TOKEN(STR_DT_DGPU_EFIFB_PROMPT),
diff --git a/Silicon/NVIDIA/Drivers/NvidiaConfigDxe/NvidiaConfigHiiMap.uni b/Silicon/NVIDIA/Drivers/NvidiaConfigDxe/NvidiaConfigHiiMap.uni
index 0932ebc0..fc4dc3ed 100644
