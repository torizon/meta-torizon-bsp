From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vladimir Skvortsov <vskvortsov@emcraft.com>
Date: Thu, 11 Jun 2026 12:12:36 -0300
Subject: [PATCH] Implement support for the Torizon boot:

* added the dedicated boot mode option NVIDIA_L4T_BOOTMODE_TORIZON
* if NVIDIA_L4T_BOOTMODE_TORIZON is selected use uEnv.txt instead of
  exlinux.conf to construct a single boot option and use it for boot
* added support for the upgrade_available and rollback U-Boot variables
  used in Torizon OTA (emulate the U-Boot variables by storing them as
  flags in the new TorizonBootFlags EFI variable)

Signed-off-by: Vladimir Skvortsov <vskvortsov@emcraft.com>
Signed-off-by: Eduardo Ferreira <eduardo.barbosa@toradex.com>
[matheus: rebased onto edk2-nvidia 0887a54c (r36.4.4-updates); manually
 reapplied NvidiaConfigDxe.inf, NvidiaConfigHii.h and NvidiaConfigHiiMap.uni
 hunks due to context drift]
Signed-off-by: Matheus Rodrigues <matheus.rodrigues@toradex.com>
[matheus: rebased onto edk2-nvidia bd49b331 (39.2.0-updates); reapplied
 fuzzy-matched hunks in NVIDIA.common.dsc.inc/L4TLauncher.c/.h/
 L4TRootfsValidation.c/NvidiaConfigDxe.c/NvidiaConfigHii.uni/.vfr/
 NVIDIAConfiguration.h/NVIDIA.dec, and manually reapplied the 3 hunks
 that no longer matched (NvidiaConfigDxe.inf, NvidiaConfigHii.h,
 NvidiaConfigHiiMap.uni - all just needed a different free PCD/KEY slot,
 upstream had taken the old ones). L4TConfiguration.dts's existing hunk
 (TorizonBootFlags variable and the Torizon default boot mode value)
 applied cleanly against the new base, no adjustment needed.]
---
diff --git a/Platform/NVIDIA/NVIDIA.common.dsc.inc b/Platform/NVIDIA/NVIDIA.common.dsc.inc
index d863a1e1..89c24a6f 100644
--- a/Platform/NVIDIA/NVIDIA.common.dsc.inc
+++ b/Platform/NVIDIA/NVIDIA.common.dsc.inc
@@ -1259,6 +1259,7 @@ CONFIG_FMP_CERTIFICATES_DTB_MAX_SIZE=0
   gNVIDIATokenSpaceGuid.PcdOsChainStatusA|L"RootfsStatusSlotA"|gNVIDIAPublicVariableGuid|0x0|0|BS,NV,RT
   gNVIDIATokenSpaceGuid.PcdOsChainStatusB|L"RootfsStatusSlotB"|gNVIDIAPublicVariableGuid|0x0|0|BS,NV,RT
   gNVIDIATokenSpaceGuid.PcdL4TDefaultBootMode|L"L4TDefaultBootMode"|gNVIDIAPublicVariableGuid|0x00|0xFF|BS,NV,RT
+  gNVIDIATokenSpaceGuid.PcdTorizonBootFlags|L"TorizonBootFlags"|gNVIDIAPublicVariableGuid|0x00|0xFF|BS,NV,RT
   gNVIDIATokenSpaceGuid.PcdIpmiNetworkBootMode|L"IpmiNetworkBootMode"|gNVIDIAPublicVariableGuid|0x0|0|BS,NV,RT
   gNVIDIATokenSpaceGuid.PcdAcpiTimerEnabled|L"AcpiTimerEnabled"|gNVIDIAPublicVariableGuid|0x0|0|BS,NV
 !ifdef CONFIG_SHELL
diff --git a/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.c b/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.c
index 319dd609..5fa6dd9e 100644
--- a/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.c
+++ b/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.c
@@ -1276,7 +1276,7 @@ EFI_STATUS
 EFIAPI
 ProcessExtLinuxConfig (
   IN EFI_HANDLE             DeviceHandle,
-  IN UINT32                 BootChain,
+  IN L4T_BOOT_PARAMS        *BootParams,
   OUT EXTLINUX_BOOT_CONFIG  *BootConfig,
   OUT EFI_HANDLE            *RootFsHandle
   )
@@ -1289,6 +1289,12 @@ ProcessExtLinuxConfig (
   CHAR16           *Timeout      = NULL;
   CHAR16           *CbootArg     = NULL;
   CHAR16           *PostCbootArg = NULL;
+  CHAR16           *UEnvKernelImage = NULL;
+  CHAR16           *UEnvRamDiskImage = NULL;
+  CHAR16           *UEnvFDTDir = NULL;
+  CHAR16           *UEnvFDTFile = NULL;
+  CHAR16           *UEnvBootArgs = NULL;
+  CHAR16           *ConfPath = NULL;
   BOOLEAN          Ascii;
   UINTN            Index;
 
@@ -1298,21 +1304,28 @@ ProcessExtLinuxConfig (
     return EFI_INVALID_PARAMETER;
   }
 
-  Status = FindPartitionInfo (DeviceHandle, ROOTFS_BASE_NAME, BootChain, NULL, RootFsHandle);
+  Status = FindPartitionInfo (DeviceHandle, ROOTFS_BASE_NAME, BootParams->BootChain, NULL, RootFsHandle);
   if (EFI_ERROR (Status)) {
     ErrorPrint (L"%a: Unable to find partition info\r\n", __FUNCTION__);
     return Status;
   }
 
+  if (BootParams->BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+    ConfPath = UENV_CONF_PATH;
+  } else {
+    ConfPath = EXTLINUX_CONF_PATH;
+  }
+
   Status = OpenAndReadFileToBuffer (
              *RootFsHandle,
-             EXTLINUX_CONF_PATH,
+             ConfPath,
              &FileHandle,
              NULL,
              NULL
              );
+
   if (EFI_ERROR (Status)) {
-    ErrorPrint (L"%a:sds Failed to Authenticate %s (%r)\r\n", __FUNCTION__, EXTLINUX_CONF_PATH, Status);
+    ErrorPrint (L"%a:sds Failed to Authenticate %s (%r)\r\n", __FUNCTION__, ConfPath, Status);
     return Status;
   }
 
@@ -1329,6 +1342,63 @@ ProcessExtLinuxConfig (
 
     CleanLine = CleanExtLinuxLine (FileLine);
     if (*CleanLine != CHAR_NULL) {
+      if (BootParams->BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+        if ((BootParams->TorizonBootFlags & TORIZON_BOOTFLAGS_ROLLBACK) == 0) {
+          Status = CheckCommandString (CleanLine, UENV_KEY_KERNEL_IMAGE, &UEnvKernelImage);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_RAMDISK_IMAGE, &UEnvRamDiskImage);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_FDTDIR, &UEnvFDTDir);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_BOOTARGS, &UEnvBootArgs);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_FDTFILE, &UEnvFDTFile);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+        } else { /* (rollback enabled) */
+          Status = CheckCommandString (CleanLine, UENV_KEY_KERNEL_IMAGE2, &UEnvKernelImage);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_RAMDISK_IMAGE2, &UEnvRamDiskImage);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_FDTDIR2, &UEnvFDTDir);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_BOOTARGS2, &UEnvBootArgs);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+
+          Status = CheckCommandString (CleanLine, UENV_KEY_FDTFILE2, &UEnvFDTFile);
+          if (!EFI_ERROR (Status)) {
+            continue;
+          }
+        }
+
+        /* ignore ExtLinux config for Torizon boot */
+        continue;
+      }
+
       Status = CheckCommandString (CleanLine, EXTLINUX_KEY_TIMEOUT, &Timeout);
       if (!EFI_ERROR (Status)) {
         BootConfig->Timeout = StrDecimalToUintn (Timeout);
@@ -1401,6 +1471,22 @@ ProcessExtLinuxConfig (
     }
   }
 
+  if (BootParams->BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+    BootConfig->NumberOfBootOptions = 1;
+    BootConfig->BootOptions[0].LinuxPath = UEnvKernelImage;
+    BootConfig->BootOptions[0].InitrdPath = UEnvRamDiskImage;
+    BootConfig->BootOptions[0].BootArgs = UEnvBootArgs;
+    if (UEnvFDTDir != NULL && UEnvFDTFile != NULL) {
+      BootConfig->BootOptions[0].DtbPath = AllocatePool((StrLen(UEnvFDTDir) + StrLen(UEnvFDTFile) + 2) * sizeof (CHAR16));
+      if (BootConfig->BootOptions[0].DtbPath != NULL) {
+        BootConfig->BootOptions[0].DtbPath[0] = 0;
+        StrCatS (BootConfig->BootOptions[0].DtbPath, StrLen(UEnvFDTDir) + StrLen(UEnvFDTFile) + 2, UEnvFDTDir);
+        StrCatS (BootConfig->BootOptions[0].DtbPath, StrLen(UEnvFDTDir) + StrLen(UEnvFDTFile) + 2, L"/");
+        StrCatS (BootConfig->BootOptions[0].DtbPath, StrLen(UEnvFDTDir) + StrLen(UEnvFDTFile) + 2, UEnvFDTFile);
+      }
+    }
+  }
+
   if (FileLine != NULL) {
     FreePool (FileLine);
     FileLine = NULL;
@@ -1858,10 +1944,24 @@ ProcessBootParams (
 
   DataSize = sizeof (BootParams->BootMode);
   Status   = gRT->GetVariable (L4T_BOOTMODE_VARIABLE_NAME, &gNVIDIAPublicVariableGuid, NULL, &DataSize, &BootParams->BootMode);
-  if (EFI_ERROR (Status) || (BootParams->BootMode > NVIDIA_L4T_BOOTMODE_RECOVERY)) {
+
+  if (EFI_ERROR (Status) || (BootParams->BootMode > NVIDIA_L4T_BOOTMODE_TORIZON)) {
     BootParams->BootMode = NVIDIA_L4T_BOOTMODE_GRUB;
   }
 
+  if (BootParams->BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+    Status   = gRT->GetVariable (
+                      TORIZON_BOOTFLAGS_VARIABLE_NAME,
+                      &gNVIDIAPublicVariableGuid,
+                      NULL,
+                      &DataSize,
+                      &BootParams->TorizonBootFlags);
+    if (EFI_ERROR (Status)) {
+      ErrorPrint (L"Failed to read boot flags (err %r)\r\n", Status);
+      BootParams->TorizonBootFlags = 0;
+    }
+  }
+
   DataSize = sizeof (BootChain);
   Status   = gRT->GetVariable (BOOT_FW_VARIABLE_NAME, &gNVIDIAPublicVariableGuid, NULL, &DataSize, &BootChain);
   // If variable does not exist, is >4 bytes or has a value larger than 1, boot partition A
@@ -2850,10 +2950,14 @@ L4TLauncher (
       } while (FALSE);
     }
 
-    if (BootParams.BootMode == NVIDIA_L4T_BOOTMODE_DIRECT) {
-      ErrorPrint (L"%a: Attempting Direct Boot\r\n", __FUNCTION__);
+    if (BootParams.BootMode == NVIDIA_L4T_BOOTMODE_DIRECT || BootParams.BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+      if (BootParams.BootMode == NVIDIA_L4T_BOOTMODE_DIRECT) {
+        ErrorPrint (L"%a: Attempting Direct Boot\r\n", __FUNCTION__);
+      } else {
+        ErrorPrint (L"%a: Attempting Torizon Boot\r\n", __FUNCTION__);
+      }
       do {
-        Status = ProcessExtLinuxConfig (DeviceHandle, BootParams.BootChain, &ExtLinuxConfig, &RootFsDeviceHandle);
+        Status = ProcessExtLinuxConfig (DeviceHandle, &BootParams, &ExtLinuxConfig, &RootFsDeviceHandle);
         if (EFI_ERROR (Status)) {
           ErrorPrint (L"%a: Unable to process extlinux config: %r\r\n", __FUNCTION__, Status);
           BootParams.BootMode = NVIDIA_L4T_BOOTMODE_BOOTIMG;
diff --git a/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.h b/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.h
index 56ad3138..1dc5c1d9 100644
--- a/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.h
+++ b/Silicon/NVIDIA/Application/L4TLauncher/L4TLauncher.h
@@ -20,6 +20,7 @@
 #define DETACHED_SIG_FILE_EXTENSION     L".sig"
 
 #define EXTLINUX_CONF_PATH  L"boot\\extlinux\\extlinux.conf"
+#define UENV_CONF_PATH      L"boot\\loader\\uEnv.txt"
 
 #define BOOTMODE_DIRECT_STRING    L"bootmode=direct"
 #define BOOTMODE_GRUB_STRING      L"bootmode=grub"
@@ -52,6 +53,18 @@
 
 #define EXTLINUX_CBOOT_ARG  L"${cbootargs}"
 
+#define UENV_KEY_KERNEL_IMAGE     L"kernel_image="
+#define UENV_KEY_RAMDISK_IMAGE    L"ramdisk_image="
+#define UENV_KEY_FDTDIR           L"fdtdir="
+#define UENV_KEY_FDTFILE          L"fdtfile="
+#define UENV_KEY_BOOTARGS         L"bootargs="
+
+#define UENV_KEY_KERNEL_IMAGE2    L"kernel_image2="
+#define UENV_KEY_RAMDISK_IMAGE2   L"ramdisk_image2="
+#define UENV_KEY_FDTDIR2          L"fdtdir2="
+#define UENV_KEY_FDTFILE2         L"fdtfile2="
+#define UENV_KEY_BOOTARGS2        L"bootargs2="
+
 #define MAX_EXTLINUX_OPTIONS  10
 
 #define SIG_FILE_SIZE_2KB  SIZE_2KB
diff --git a/Silicon/NVIDIA/Application/L4TLauncher/L4TRootfsValidation.c b/Silicon/NVIDIA/Application/L4TLauncher/L4TRootfsValidation.c
index f12ab9f1..3b897c0a 100644
--- a/Silicon/NVIDIA/Application/L4TLauncher/L4TRootfsValidation.c
+++ b/Silicon/NVIDIA/Application/L4TLauncher/L4TRootfsValidation.c
@@ -638,6 +638,10 @@ ValidateRootfsStatus (
     return EFI_SUCCESS;
   }
 
+  if (BootParams->BootMode == NVIDIA_L4T_BOOTMODE_TORIZON) {
+    BootParams->BootChain = ROOTFS_SLOT_A;
+  }
+
   if (BootParams->BootChain > ROOTFS_SLOT_B) {
     DEBUG ((
       DEBUG_ERROR,
@@ -687,6 +691,7 @@ ValidateRootfsStatus (
 
   // Set BootMode to RECOVERY if there is no more valid rootfs
   if (!IsValidRootfs ()) {
+
     BootParams->BootMode = NVIDIA_L4T_BOOTMODE_RECOVERY;
 
     // Clear the SR_RF when boot to recovery kernel.
@@ -706,7 +711,8 @@ ValidateRootfsStatus (
   }
 
   // Check redundancy level and validate rootfs status
-  switch (mRootfsInfo.RootfsVar[RF_REDUNDANCY].Value) {
+  if (BootParams->BootMode != NVIDIA_L4T_BOOTMODE_TORIZON) {
+    switch (mRootfsInfo.RootfsVar[RF_REDUNDANCY].Value) {
     case NVIDIA_OS_REDUNDANCY_BOOT_ONLY:
       // There is no rootfs B. Ensure to set rootfs slot to A.
       if (mRootfsInfo.CurrentSlot != ROOTFS_SLOT_A) {
@@ -830,6 +836,55 @@ ValidateRootfsStatus (
         mRootfsInfo.RootfsVar[RF_REDUNDANCY].Value
         ));
       break;
+    }
+  } else { /* Torizon Boot */
+    if (IsRootfsSlotBootable (mRootfsInfo.CurrentSlot)) {
+      if (BootParams->TorizonBootFlags & TORIZON_BOOTFLAGS_UPGRADE_AVAILABLE) {
+        Status = DecreaseRootfsRetryCount (mRootfsInfo.CurrentSlot);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((
+            DEBUG_ERROR,
+            "%a: Failed to decrease the RetryCount of slot %d: %r\n",
+            __FUNCTION__,
+            mRootfsInfo.CurrentSlot,
+            Status
+            ));
+          goto Exit;
+        }
+      }
+    } else {
+      if (BootParams->TorizonBootFlags & TORIZON_BOOTFLAGS_UPGRADE_AVAILABLE) {
+        ErrorPrint (L"The boot counter has expired, setting the rollback flag\r\n");
+        Status = SetRetryCountTomRootfsInfo (mRootfsInfo.CurrentSlot, mRootfsInfo.RootfsVar[RF_RETRY_MAX].Value);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((
+            DEBUG_ERROR,
+            "%a: Failed to reset the RetryCount of slot %d: %r\n",
+            __FUNCTION__,
+            mRootfsInfo.CurrentSlot,
+            Status
+            ));
+          goto Exit;
+        }
+        BootParams->TorizonBootFlags = TORIZON_BOOTFLAGS_ROLLBACK;
+        Status = gRT->SetVariable (
+                        TORIZON_BOOTFLAGS_VARIABLE_NAME,
+                        &gNVIDIAPublicVariableGuid,
+                        EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_RUNTIME_ACCESS,
+                        1,
+                        &BootParams->TorizonBootFlags);
+        if (EFI_ERROR (Status)) {
+          DEBUG ((
+            DEBUG_ERROR,
+            "%a: Failed to update Torizon BootFlags %x: %r\n",
+            __FUNCTION__,
+            BootParams->TorizonBootFlags,
+            Status
+            ));
+          goto Exit;
+        }
+      }
+    }
   }
 
 Exit:
