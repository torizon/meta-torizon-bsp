 #string STR_OS_STATUS_B_HELP                 #language en-US "Used to set the status of OS chain B."
 #string STR_L4T_BOOTMODE_PROMPT              #language en-US "L4T Boot Mode"
 #string STR_L4T_BOOTMODE_HELP                #language en-US "Used to override boot mode of l4t launcher."
+#string STR_TORIZON_PROMPT                   #language en-US "Torizon Boot Flags"
+#string STR_TORIZON_HELP                     #language en-US "Used to override Torizon boot flags."
 #string STR_DT_DGPU_EFIFB_PROMPT             #language en-US "dGPU EFIFB Support (DT Mode)"
 #string STR_DT_DGPU_EFIFB_HELP               #language en-US "Enable to support dGPU EFIFB in device tree mode."
