# Build environment setup for the ADLINK LEC-MTK-i1200 (MediaTek Genio 1200 /
# MT8395) on the I-Pi SMARC 1200 carrier board.

[ -z "${SDKMACHINE}" ] && SDKMACHINE='x86_64'

# resolve/export BUILDDIR ourselves, then rebuild PATH and
# BB_ENV_PASSTHROUGH_ADDITIONS.
tdx_set_builddir "${1:-}" "${DISTRO}" || return 1
tdx_setup_path
tdx_setup_bb_env_passthrough

# Early-return if MACHINE/DISTRO/script-checksum are all unchanged - and if the
# Mali EULA acceptance below still matches ${EULA}. That half is checked here
# rather than through tdx_native_conf_is_current's eula-conf-var argument,
# which reads an ACCEPT_*-style scalar; this machine's knob is an append to
# LICENSE_FLAGS_ACCEPTED. tdx_native_conf_is_current comes first because it
# also sets _TDX_AUTO_CONF_CREATED, which tdx_write_auto_conf needs below to
# update an existing auto.conf instead of appending a second block to it.
_TDX_MTK_EULA=$(grep -q '^LICENSE_FLAGS_ACCEPTED' conf/local.conf 2>/dev/null && echo 1)
if tdx_native_conf_is_current && [ "${EULA:-}" = "${_TDX_MTK_EULA}" ]; then
    unset _TDX_MTK_EULA
    return 0
fi
unset _TDX_MTK_EULA

tdx_write_checksum "${_TDX_SCRIPTS}/lib/setup-devices/setup-environment-mtk"

tdx_conf_from_template local.conf

tdx_append_once conf/bblayers.conf "# Torizon" <<EOF
# Torizon
# LAYER_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LCONF_VERSION = "7"
OEROOT := "\${@os.path.abspath(os.path.dirname(d.getVar('FILE', True)))}/../.."

BBPATH = "\${TOPDIR}"

BBFILES = ""

# These layers hold recipe metadata not found in OE-core, but lack any machine or distro content
BASELAYERS ?= " \\
  \${OEROOT}/layers/meta-openembedded/meta-oe \\
  \${OEROOT}/layers/meta-openembedded/meta-networking \\
  \${OEROOT}/layers/meta-openembedded/meta-filesystems \\
  \${OEROOT}/layers/meta-openembedded/meta-multimedia \\
  \${OEROOT}/layers/meta-openembedded/meta-python \\
  \${OEROOT}/layers/meta-openembedded/meta-perl \\
  \${OEROOT}/layers/meta-virtualization \\
  \${OEROOT}/layers/meta-updater \\
"

# These layers hold machine specific content, aka Board Support Packages.
# meta-arm and meta-clang must precede the MediaTek layers, and meta-adlink-mtk
# must come after meta-mediatek-bsp.
BSPLAYERS ?= " \\
  \${OEROOT}/layers/meta-yocto/meta-yocto-bsp \\
  \${OEROOT}/layers/meta-yocto/meta-poky \\
  \${OEROOT}/layers/meta-arm/meta-arm-toolchain \\
  \${OEROOT}/layers/meta-arm/meta-arm \\
  \${OEROOT}/layers/meta-clang \\
  \${OEROOT}/layers/meta-mediatek-bsp \\
  \${OEROOT}/layers/meta-adlink-mtk \\
"

# Add your overlay location to EXTRALAYERS
# Make sure to have a conf/layers.conf in there
EXTRALAYERS ?= ""

BBLAYERS = " \\
  \${OEROOT}/layers/meta-torizon-bsp \\
  \${OEROOT}/layers/meta-torizon \\
  \${BASELAYERS} \\
  \${BSPLAYERS} \\
  \${EXTRALAYERS} \\
  \${OEROOT}/layers/openembedded-core/meta \\
"
EOF

ln -sf "${_TDX_MANIFESTS}/README.md" README.md
ln -sf "${_TDX_MANIFESTS}" "${_TDX_OEROOT}/layers/"

tdx_write_auto_conf "${DISTRO}" "${MACHINE}" "${SDKMACHINE}" "rm_work"
tdx_apply_integration_override conf/auto.conf

tdx_write_site_conf "${_TDX_OEROOT}" "${_TDX_BUILDDIR}"

# The default Mali DDK userspace (libmali) is commercial-licensed. Accept it via
# EULA=1 when sourcing this script, or by uncommenting the line below. Not needed
# for the open-source Panfrost/Mesa provider (see common-mtk.inc).
if [ "${EULA:-}" = "1" ]; then
    if ! grep -q '^LICENSE_FLAGS_ACCEPTED' conf/local.conf; then
        cat >> conf/local.conf <<EOF

# Accept the commercial license required by the proprietary Mali DDK (libmali).
LICENSE_FLAGS_ACCEPTED += "commercial"
EOF
    fi
elif ! grep -q 'LICENSE_FLAGS_ACCEPTED' conf/local.conf; then
    cat >> conf/local.conf <<EOF

# Uncomment to accept the commercial license required by the proprietary Mali
# DDK (libmali). Not needed for the open-source Panfrost/Mesa GPU provider.
#LICENSE_FLAGS_ACCEPTED += "commercial"
EOF
fi

tdx_print_banner "Common Torizon OS" yes
